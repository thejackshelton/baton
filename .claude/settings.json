{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.baton/lib/bin/baton.mjs\" context || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.baton/lib/adapters/claude-code/stop.mjs\" || true"
          }
        ]
      }
    ]
  }
}
